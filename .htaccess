Options -Indexes
DirectoryIndex index.html
<FilesMatch "^(config\.php|config\.sample\.php|.*\.sql|.*\.md)$">
  Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule ^api/lib/ - [F,L]
RewriteRule ^api/modules/ - [F,L]
# Static files: cache, but always re-check the app shell
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">Header set Cache-Control "no-cache"</FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>
